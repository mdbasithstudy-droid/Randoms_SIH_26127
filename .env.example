# =====================================================================
# TrafIQ — Frontend Firebase Web config (client-side, safe to expose)
# Fill these in to switch the app from OFFLINE DEMO MODE to LIVE
# Firestore mode. Leave them blank/empty to run the fully self-contained
# demonstration (local browser store) — no credentials required.
#
# Create a Firebase project -> Project settings -> Your apps -> Web app.
# =====================================================================

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: full URL of the deployed Python backend (Vercel).
# In dev, requests are proxied to http://localhost:8000 automatically.
# When deployed together on Vercel, "/api" is same-origin.
VITE_API_URL=/api

# =====================================================================
# Python backend (server-side) — Firebase Admin SDK
# NEVER expose these in the frontend. Keep them only on the server
# (Vercel environment variables).
#
# Option A: set GOOGLE_APPLICATION_CREDENTIALS to the path of your
#           service-account JSON on a local machine.
# Option B: paste the entire service-account JSON as the value of
#           FIREBASE_SERVICE_ACCOUNT (Vercel-friendly).
# =====================================================================

GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_SERVICE_ACCOUNT=
